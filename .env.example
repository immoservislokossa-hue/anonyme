# Modèle de langage. DeepSeek est utilisé s'il est configuré, sinon Anthropic.
# Sans aucune clé, le chat répond uniquement avec la base de connaissances.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Pour forcer un fournisseur : deepseek ou anthropic
# LLM_PROVIDER=

# Google Maps (API Places, version « New »). Clé réservée au serveur, à restreindre à l'API Places.
# Sans clé, la recherche autour de moi affiche seulement les centres partenaires.
GOOGLE_MAPS_API_KEY=

# Jeton d'accès à la page /partenaires. Obligatoire en production.
PARTNER_TOKEN=
