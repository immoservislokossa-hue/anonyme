# Clé API Anthropic. Sans clé, l'application répond uniquement avec la base de connaissances.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération. Remplacez-le par un modèle plus léger pour réduire les coûts.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Jeton d'accès à la page /partenaires. Obligatoire en production.
PARTNER_TOKEN=
