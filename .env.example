# Modèle de langage. DeepSeek est utilisé s'il est configuré, sinon Anthropic.
# Sans aucune clé, le chat répond uniquement avec la base de connaissances.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Pour forcer un fournisseur : deepseek ou anthropic
# LLM_PROVIDER=

# Lieux (centres de santé et pharmacies). Ordre d'essai : Google (clé officielle), puis Scrappa.
# Sans clé, la page renvoie vers les centres partenaires.
GOOGLE_MAPS_API_KEY=
# La clé peut aussi s'appeler SCRAPPA_M…S_API_KEY (par exemple SCRAPPA_MAPS_API_KEY).
SCRAPPA_API_KEY=
# Nombre maximal de recherches Scrappa par mois (l'offre gratuite donne 500 crédits). Compteur en mémoire.
SCRAPPA_MONTHLY_BUDGET=400
# Pour forcer une source : google ou scrappa
# PLACES_PROVIDER=

# Jeton d'accès à la page /partenaires. Obligatoire en production.
PARTNER_TOKEN=

# Autres canaux (affichés sur l'accueil ; sans valeur, le bouton indique « Bientôt »)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_MESSENGER_PAGE=
NEXT_PUBLIC_CALL_NUMBER=

# Stockage de la plateforme (événements anonymes, annuaire des services, avis, bilans). Sans ces deux valeurs : mémoire temporaire.
# Créer la table avec docs/schema.sql. N'utiliser la clé « service_role » que côté serveur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
