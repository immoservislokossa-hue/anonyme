# Modèle de langage. DeepSeek est utilisé s'il est configuré, sinon Anthropic.
# Sans aucune clé, le chat répond uniquement avec la base de connaissances.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Pour forcer un fournisseur : deepseek ou anthropic
# LLM_PROVIDER=

# Lieux (centres de santé et pharmacies). OpenStreetMap est toujours disponible, sans clé ni carte bancaire.
# Ordre d'essai : Google (clé officielle), puis Scrappa (recherche par nom de lieu), puis OpenStreetMap.
GOOGLE_MAPS_API_KEY=
SCRAPPA_API_KEY=
# Nombre maximal de recherches Scrappa par mois (l'offre gratuite donne 500 crédits). Compteur en mémoire.
SCRAPPA_MONTHLY_BUDGET=400
# Pour forcer une source : osm, google ou scrappa
# PLACES_PROVIDER=

# Jeton d'accès à la page /partenaires. Obligatoire en production.
PARTNER_TOKEN=
